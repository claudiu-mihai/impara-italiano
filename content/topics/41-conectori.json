    },
    {
      "it": "«Invece» = al contrario; «anzi» = al contrario, o ancora di più.",
      "ro": "«Invece» = în schimb; «anzi» = ba chiar / dimpotrivă."
    },
    {
      "it": "«Quindi» = di conseguenza; «comunque» = in ogni caso; «infatti» = in effetti.",
      "ro": "«Quindi» = deci; «comunque» = oricum; «infatti» = într-adevăr / de fapt."
