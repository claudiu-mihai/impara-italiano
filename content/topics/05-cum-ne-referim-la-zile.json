{
  "id": "cum-ne-referim-la-zile",
  "title": "Cum ne referim la zile",
  "group": "timp",
  "level": "A2",
  "first": true,
  "rules": [
    "«Fa» vine după durată: «due giorni fa» = acum două zile. «Fra/tra» + durată = peste: «fra una settimana».",
    "«Scorso» = trecut, «prossimo» = viitor; stau după substantiv: «la settimana scorsa», «il mese prossimo».",
    "«Ieri sera» = aseară, «ieri mattina» = ieri dimineață, «domani sera» = mâine seară."
  ],
