        ["masculin, înaintea consoanei", "il libro", "i libri"],
        ["masculin, înaintea s + consoană, z, gn, ps", "lo studente", "gli studenti"],
        ["masculin, înaintea vocalei", "l'amico", "gli amici"],
        ["feminin, înaintea consoanei", "la casa", "le case"],
        ["feminin, înaintea vocalei", "l'amica", "le amiche"]
      ]
    },
    {
      "type": "examples",
      "items": [
        { "it": "il giorno", "ro": "ziua" },
        { "it": "lo zaino", "ro": "rucsacul", "note": "[it]lo[/it], pentru că începe cu z" },
        { "it": "l'ospedale", "ro": "spitalul", "note": "masculin, dar [it]l'[/it], pentru că începe cu vocală" },
