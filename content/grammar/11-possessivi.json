  "lesson": [
    {
      "type": "text",
      "ro": "Posesivul se acordă cu [b]lucrul posedat[/b], nu cu cel care îl are, și de obicei are articol în față: [it]la mia casa[/it] = casa mea, [it]il mio amico[/it] = prietenul meu."
    },
    {
      "type": "table",
      "caption": "Posesivele",
      "head": ["", "masc. sg.", "fem. sg.", "masc. pl.", "fem. pl."],
      "rows": [
        ["al meu", "il mio", "la mia", "i miei", "le mie"],
        ["al tău", "il tuo", "la tua", "i tuoi", "le tue"],
        ["al lui / al ei", "il suo", "la sua", "i suoi", "le sue"],
        ["al nostru", "il nostro", "la nostra", "i nostri", "le nostre"],
        ["al vostru", "il vostro", "la vostra", "i vostri", "le vostre"],
        ["al lor", "il loro", "la loro", "i loro", "le loro"]
      ]
    },
    {
      "type": "text",
      "ro": "[it]Suo[/it] înseamnă și „al lui”, și „al ei”: [it]la sua macchina[/it] poate fi mașina lui sau a ei. Contextul lămurește."
    },
    {
      "type": "text",
      "ro": "Cu rudele la [b]singular[/b], articolul dispare: [it]mia madre[/it], [it]tuo fratello[/it]. La plural revine: [it]le mie sorelle[/it], [it]i miei genitori[/it]."
    },
    {
      "type": "examples",
      "items": [
        { "it": "È la mia macchina.", "ro": "Este mașina mea." },
        { "it": "Mia madre è italiana.", "ro": "Mama mea este italiancă.", "note": "rudă la singular: fără articol" },
        { "it": "I miei amici sono qui.", "ro": "Prietenii mei sunt aici." },
        { "it": "Dov'è la tua borsa?", "ro": "Unde e geanta ta?" },
        { "it": "Lucia e il suo ragazzo.", "ro": "Lucia și prietenul ei.", "note": "aici [it]suo[/it] = al ei; se acordă cu [it]ragazzo[/it]" }
      ]
    },
    {
      "type": "trap",
      "ro": "[it]Loro[/it] nu se schimbă și păstrează mereu articolul: [it]la loro casa[/it], [it]i loro figli[/it], chiar și cu rudele: [it]il loro padre[/it]."
    }
  ],
  "rules": [
    "Posesivul se acordă cu lucrul posedat: il mio libro, la mia casa, i miei libri, le mie case.",
    "De obicei are articol: la mia casa (casa mea).",
    "Rudele la singular nu au articol: mia madre, tuo fratello; la plural da: i miei fratelli.",
    "loro nu se schimbă și are mereu articol: la loro casa, il loro padre."
  ],
  "items": [
