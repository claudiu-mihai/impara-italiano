    {
      "type": "text",
      "ro": "Negația e simplă: pui [it]non[/it] [b]înaintea verbului[/b], ca pe „nu” în română: [it]Non parlo tedesco.[/it] = Nu vorbesc germana."
    },
    {
      "type": "text",
      "ro": "Ca în română, negația se dublează: [it]Non vedo niente.[/it] = Nu văd nimic. [it]Non c'è nessuno.[/it] = Nu e nimeni."
    },
    {
      "type": "table",
      "caption": "Negații duble",
      "head": ["italiană", "română"],
      "itColumns": [0],
      "rows": [
        ["non … niente / nulla", "nu … nimic"],
        ["non … nessuno", "nu … nimeni"],
        ["non … mai", "nu … niciodată"],
        ["non … più", "nu … mai"],
        ["non … ancora", "încă nu"]
      ]
    },
    {
      "type": "text",
      "ro": "Întrebarea se face doar din [b]intonație[/b], fără să schimbi ordinea cuvintelor: [it]Sei stanco.[/it] → [it]Sei stanco?[/it]"
    },
    {
      "type": "table",
      "caption": "Cuvinte de întrebare",
      "head": ["italiană", "română"],
      "itColumns": [0],
      "rows": [
        ["chi?", "cine?"],
        ["che cosa? / cosa?", "ce?"],
        ["dove?", "unde?"],
        ["quando?", "când?"],
        ["come?", "cum?"],
        ["perché?", "de ce?"],
        ["quanto? / quanti?", "cât? / câți?"],
        ["quale?", "care?"]
      ]
    },
    {
      "type": "examples",
      "items": [
        { "it": "Non ho tempo.", "ro": "Nu am timp." },
        { "it": "Non mangio mai carne.", "ro": "Nu mănânc niciodată carne.", "note": "[it]mai[/it] = niciodată" },
        { "it": "Non abito più qui.", "ro": "Nu mai locuiesc aici.", "note": "„nu mai” = [it]non … più[/it]" },
        { "it": "Dove abiti?", "ro": "Unde locuiești?" },
        { "it": "Perché non vieni?", "ro": "De ce nu vii?", "note": "[it]perché[/it] înseamnă și „de ce”, și „pentru că”" }
